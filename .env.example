# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 本機優先模式（#36）=====
# 一行切到全本機：local（System One 決策、零 decode 準備）或 local-llm（本機 LLM 決策）。
# 只補上未設定的變數；詳見 docs/local-first.md
# MIROFISH_PROFILE=local

# ===== 本機模型（docker compose --profile local）=====
# 10GB 開發機用 4-bit AWQ。16GB 改 LOCAL_LLM_MODEL / LLM_MODEL_NAME 為 Qwen/Qwen3.5-4B（BF16）。
# LLM_API_KEY=local
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_NAME=SubSir/Qwen3.5-4B-AWQ
# LOCAL_LLM_MODEL=SubSir/Qwen3.5-4B-AWQ
# LOCAL_EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_BASE_URL=http://localhost:8001/v1
# EMBED_MODEL_NAME=intfloat/multilingual-e5-small

# ===== 本機圖譜（GRAPH_BACKEND=local，不需要 ZEP_API_KEY）=====
# GRAPH_BACKEND=local
# GRAPH_DATA_DIR=./backend/uploads/graphs
# GRAPH_EMBEDDER=http            # http = EMBED_BASE_URL 的 /v1/embeddings；hash = 無模型的字元 n-gram（測試用）
# GRAPH_EXTRACTOR=local          # local = 零 decode 抽取（System One 讀出，需要 SYSTEM_ONE_*）；stub = 測試用
# LOCAL_NER=candidates           # candidates（預設，規則候選 + System One）或 gliner（需另裝 gliner torch jieba3 protobuf sentencepiece）
# EXTRACT_SUMMARY_LLM=0          # 1 = 用小模型寫節點摘要（會 decode）

# ===== System One 決策層（Jev 相容）=====
# local：讀本機模型服務的 logprobs（vLLM / llama.cpp /v1/completions，max_tokens=1）
# http：POST {SYSTEM_ONE_BASE_URL}/v1/systemone（TypeSafe Jev 或 OpenJev server）
# SYSTEM_ONE_BACKEND=local
# SYSTEM_ONE_BASE_URL=http://localhost:8000/v1
# SYSTEM_ONE_MODEL=qwen3.5-4b
# SYSTEM_ONE_API_KEY=
# SYSTEM_ONE_TOP_K=20

# ===== 模擬決策（#9）=====
# llm：每個活躍 agent 由 camel 模型 decode tool call（預設）
# system_one：階層式 System One 決策，不經 decode（需要 SYSTEM_ONE_*）
# SIM_DECISION_BACKEND=llm
# SIM_AGENT_CONTEXT_TOKENS=3072  # llm 決策時 agent 記憶的 token 上限（camel 對未知模型預設 ~1e9，記憶會超出
#                                # 每個 slot 的 context 而丟失回合）。未設定時：LLM_BASE_URL 是本機 → 3072；雲端 → 不限。0/off = 關閉
# SIM_EMOTION_ALPHA=0.7          # 情緒慣性 e_t = α·e_{t-1} + (1-α)·readout_t
